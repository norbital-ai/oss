	"scripts": {
		"build": "node ../../scripts/build-package.mjs tsc -p tsconfig.json --outDir {}",
		"prepack": "pnpm exec turbo run build --filter=@norbital-ai/platform-utils",
		"lint": "tsc -p tsconfig.json --noEmit",
		"test": "node --test tests/*.test.ts"
	},
	"dependencies": {
		"@neondatabase/serverless": "^1.1.0",
		"@norbital-ai/std": "workspace:*",
		"@standard-schema/spec": "^1.1.0",
		"drizzle-orm": "catalog:",
