{
	"name": "@norbital-ai/bolt-server",
	"version": "0.0.5",
	"description": "An example untethered Bolt host: one workspace artifact served on its own facility adapters.",
	"type": "module",
	"sideEffects": false,
	"license": "AGPL-3.0-only",
	"exports": {
		".": {
			"types": "./build/index.d.ts",
			"default": "./build/index.js"
		}
	},
	"bin": {
		"bolt-server": "./build/main.js"
	},
	"files": [
		"build",
		"package.json"
	],
	"scripts": {
		"build": "node ../../scripts/build-package.ts tsc -p tsconfig.json --outDir {}",
		"lint": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
		"prepack": "pnpm exec turbo run build --filter=@norbital-ai/bolt-server"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:",
		"@norbital-ai/bolt": "workspace:*",
		"@norbital-ai/providers": "workspace:*",
		"@norbital-ai/std": "workspace:*",
		"@norbital-ai/store": "workspace:*",
		"effect": "catalog:",
		"exceljs": "4.4.0",
		"mammoth": "1.13.0",
		"mssql": "12.7.13",
		"pdfjs-dist": "6.4.299",
		"pg": "^8.23.1",
		"web-push": "^3.6.7"
	},
	"devDependencies": {
		"@types/mssql": "12.3.0",
		"@types/node": "^26.6.5",
		"@types/pg": "^8.23.1",
		"@types/web-push": "^3.6.4",
		"typescript": "catalog:"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/norbital-ai/oss.git",
		"directory": "packages/bolt-server"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
