{
	"name": "@norbital-ai/bolt-server",
	"version": "0.0.11",
	"description": "An example untethered Bolt host: one workspace artifact served on its own facility adapters.",
	"type": "module",
	"sideEffects": false,
	"license": "AGPL-3.0-only",
	"exports": {
		"./host": {
			"types": "./build/host.d.ts",
			"default": "./build/host.js"
		}
	},
	"bin": {
		"bolt-server": "./build/main.js"
	},
	"files": [
		"build",
		"example",
		"package.json"
	],
	"scripts": {
		"build": "node ../../scripts/build-package.ts tsc -p tsconfig.json --outDir {} --then cp -R src/audit/standalone src/audit/scoped build/audit/",
		"lint": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
		"migrations:audit": "node --experimental-strip-types scripts/audit-migrations.ts",
		"prepack": "pnpm exec turbo run build --filter=@norbital-ai/bolt-server"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:",
		"@electric-sql/pglite": "^0.5.12",
		"@norbital-ai/host-api": "workspace:*",
		"@norbital-ai/providers": "workspace:*",
		"@norbital-ai/store": "workspace:*",
		"effect": "catalog:",
		"pg": "^8.23.1",
		"playwright": "1.64.1"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"@types/pg": "^8.23.1",
		"typescript": "catalog:"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/norbital-ai/oss.git",
		"directory": "packages/bolt-server"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
