{
	"name": "@norbital-ai/std",
	"version": "0.0.16",
	"description": "Shared schema, date, CEL, finance, and utility modules for Norbital.",
	"type": "module",
	"sideEffects": false,
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/norbital-ai/oss.git",
		"directory": "packages/std"
	},
	"homepage": "https://github.com/norbital-ai/oss/tree/main/packages/std",
	"bugs": {
		"url": "https://github.com/norbital-ai/oss/issues"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"files": [
		"build",
		"package.json"
	],
	"exports": {
		".": {
			"types": "./build/index.d.ts",
			"default": "./build/index.js"
		},
		"./async": {
			"types": "./build/async/index.d.ts",
			"default": "./build/async/index.js"
		},
		"./billing": {
			"types": "./build/billing/index.d.ts",
			"default": "./build/billing/index.js"
		},
		"./cache": {
			"types": "./build/cache/index.d.ts",
			"default": "./build/cache/index.js"
		},
		"./cel": {
			"types": "./build/cel/index.d.ts",
			"default": "./build/cel/index.js"
		},
		"./collection": {
			"types": "./build/collection/index.d.ts",
			"default": "./build/collection/index.js"
		},
		"./date": {
			"types": "./build/date/index.d.ts",
			"default": "./build/date/index.js"
		},
		"./error": {
			"types": "./build/error/index.d.ts",
			"default": "./build/error/index.js"
		},
		"./finance": {
			"types": "./build/finance/index.d.ts",
			"default": "./build/finance/index.js"
		},
		"./json": {
			"types": "./build/json/index.d.ts",
			"default": "./build/json/index.js"
		},
		"./i18n": {
			"types": "./build/i18n/index.d.ts",
			"default": "./build/i18n/index.js"
		},
		"./reckon": {
			"types": "./build/reckon/index.d.ts",
			"default": "./build/reckon/index.js"
		},
		"./rate-limit": {
			"types": "./build/rate-limit/index.d.ts",
			"default": "./build/rate-limit/index.js"
		},
		"./secret": {
			"types": "./build/secret/index.d.ts",
			"default": "./build/secret/index.js"
		},
		"./result": {
			"types": "./build/result/index.d.ts",
			"default": "./build/result/index.js"
		},
		"./string": {
			"types": "./build/string/index.d.ts",
			"default": "./build/string/index.js"
		},
		"./text": {
			"types": "./build/text/index.d.ts",
			"default": "./build/text/index.js"
		},
		"./text/dedent": {
			"types": "./build/text/dedent/index.d.ts",
			"default": "./build/text/dedent/index.js"
		},
		"./tree": {
			"types": "./build/tree/index.d.ts",
			"default": "./build/tree/index.js"
		},
		"./truncate": {
			"types": "./build/truncate/index.d.ts",
			"default": "./build/truncate/index.js"
		}
	},
	"scripts": {
		"build": "node ../../scripts/build-package.mjs tsc -p tsconfig.json --outDir {}",
		"prepack": "pnpm exec turbo run build --filter=@norbital-ai/std",
		"lint": "tsc -p tsconfig.json --noEmit",
		"test": "node --test tests/*.test.ts"
	},
	"dependencies": {
		"@marcbachmann/cel-js": "^8.0.0",
		"dedent": "^1.7.2",
		"effect": "4.0.0-rc.109",
		"js-yaml": "^5.3.0"
	},
	"devDependencies": {
		"@norbital-ai/config": "workspace:*",
		"@sveltejs/kit": "catalog:",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^26.2.0",
		"typescript": "catalog:"
	}
}
