{
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
	"rulePacks": ["tenant/policy.jsonc"],
	"entry": [
		"src/+seed.ts",
		"src/apps/**/+group.ts",
		"src/apps/**/+*.svelte",
		"src/automation/+*.ts",
		"src/collections/+relationship.ts",
		"src/collections/**/+model.ts",
		"src/collections/**/+hooks.ts",
		"src/collections/**/+pipelines.ts",
		"src/collections/**/+integrations.ts",
		"src/remotes/+*.ts"
	],
	"ignoreDependencies": [
		"@iconify/svelte",
		"@norbital-ai/platform-utils",
		"@norbital-ai/pod",
		"@norbital-ai/std",
		"@norbital-ai/ui",
		"mode-watcher",
		"runed",
		"svelte",
		"svelte-check",
		"typescript",
		"vite",
		"zod"
	],
	"ignoreUnresolvedImports": ["$pod/client", "**/$types.js"],
	"ignorePatterns": [
		".agents/**",
		".norbital/**",
		".tmp/**",
		"node_modules/**",
		"coverage/**",
		"dist/**",
		"build/**",
		"**/*.test.*",
		"**/*.spec.*"
	],
	"rules": {
		"unused-files": "error",
		"unused-dependencies": "error",
		"unlisted-dependencies": "error",
		"unresolved-imports": "error",
		"circular-dependencies": "error",
		"re-export-cycle": "error",
		"policy-violation": "error",
		"stale-suppressions": "warn",
		"require-suppression-reason": "warn",
		"unused-exports": "off",
		"unused-types": "off",
		"unused-class-members": "off"
	},
	"duplicates": {
		"ignore": [".agents/**", ".norbital/**", "node_modules/**", "**/*.test.*", "**/*.spec.*"],
		"skipLocal": true,
		"minTokens": 80,
		"ignoreImports": true
	},
	"health": {
		"maxCyclomatic": 30,
		"maxCognitive": 40,
		"maxCrap": 600
	},
	"audit": {
		"css": true,
		"cssDeep": false
	}
}
