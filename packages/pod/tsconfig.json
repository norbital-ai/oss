{
	"extends": "@norbital-ai/config/svelte.json",
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"paths": {
			"$lib/*": ["./src/lib/*"]
		}
	},
	"include": ["src/lib/**/*.ts", "src/lib/**/*.svelte"],
	"exclude": ["src/lib/**/__tests__/**", "**/*.test-d.ts", "build/**"]
}
