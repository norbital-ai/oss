{
	"name": "@norbital-ai/bolt",
	"version": "0.0.6",
	"description": "Bolt: the business OS framework — declarations, page SDK, protocol and the engine hosts run.",
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"license": "AGPL-3.0-only",
	"exports": {
		".": {
			"types": "./build/index.d.ts",
			"default": "./build/index.js"
		},
		"./errors": {
			"types": "./build/decl/errors.d.ts",
			"default": "./build/decl/errors.js"
		},
		"./page": {
			"types": "./build/page/index.d.ts",
			"default": "./build/page/index.js"
		},
		"./page/integrations": {
			"types": "./build/page/integration.d.ts",
			"svelte": "./build/page/integration.js",
			"default": "./build/page/integration.js"
		},
		"./engine": {
			"types": "./build/engine/index.d.ts",
			"default": "./build/engine/index.js"
		},
		"./artifact": {
			"types": "./build/engine/artifact/read.d.ts",
			"default": "./build/engine/artifact/read.js"
		},
		"./protocol": {
			"types": "./build/protocol/index.d.ts",
			"default": "./build/protocol/index.js"
		},
		"./protocol/cursor": {
			"types": "./build/protocol/cursor.d.ts",
			"default": "./build/protocol/cursor.js"
		},
		"./facilities": {
			"types": "./build/facilities/index.d.ts",
			"default": "./build/facilities/index.js"
		},
		"./host-api": {
			"types": "./build/protocol/host-api.d.ts",
			"default": "./build/protocol/host-api.js"
		},
		"./cell": {
			"types": "./build/protocol/cell.d.ts",
			"default": "./build/protocol/cell.js"
		},
		"./node": {
			"types": "./build/node/index.d.ts",
			"default": "./build/node/index.js"
		},
		"./docs": {
			"types": "./build/docs/index.d.ts",
			"default": "./build/docs/index.js"
		},
		"./isolate-globals": {
			"types": "./build/engine/guest/globals.d.ts",
			"default": "./build/engine/guest/globals.js"
		},
		"./guest-hooks": {
			"types": "./build/node/guest-hooks.d.ts",
			"default": "./build/node/guest-hooks.js"
		},
		"./tooling": {
			"types": "./build/tooling/index.d.ts",
			"default": "./build/tooling/index.js"
		},
		"./tooling/browser": {
			"types": "./build/tooling/browser.d.ts",
			"default": "./build/tooling/browser.js"
		}
	},
	"files": [
		"build",
		"toolchain.json",
		"package.json"
	],
	"scripts": {
		"build": "node ../../scripts/build-package.ts svelte-package -i src -o {} --tsconfig tsconfig.json --then node scripts/docs.ts --then node scripts/cell-bundle.ts",
		"lint": "svelte-check --tsconfig ./tsconfig.json && tsgo -p tests/tsconfig.json --noEmit",
		"types:compat": "tsc -p tests/tsconfig.json --noEmit",
		"migrations:audit": "node --experimental-strip-types scripts/audit-migrations.ts",
		"prepack": "pnpm exec turbo run build --filter=@norbital-ai/bolt"
	},
	"dependencies": {
		"@cfworker/json-schema": "4.1.1",
		"@effect/platform-node": "catalog:",
		"@electric-sql/pglite": "^0.5.12",
		"@electric-sql/pglite-pgvector": "^0.0.13",
		"@iconify/svelte": "catalog:",
		"@jridgewell/trace-mapping": "^0.3.31",
		"@modelcontextprotocol/client": "2.4.0",
		"@norbital-ai/std": "workspace:*",
		"@norbital-ai/store": "workspace:*",
		"@norbital-ai/ui": "workspace:*",
		"@typescript/native": "npm:typescript@7.0.2",
		"exifr": "7.1.3",
		"fast-png": "8.0.0",
		"fflate": "0.8.3",
		"jpeg-js": "0.4.4",
		"libheif-js": "1.23.5",
		"pdq-wasm": "0.3.9",
		"rolldown": "1.2.15",
		"runed": "catalog:",
		"svelte2tsx": "0.7.62",
		"tailwindcss": "4.3.3",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"effect": "catalog:",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@iconify-json/vscode-icons": "1.2.94",
		"@sveltejs/package": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "^26.6.5",
		"@types/pg": "^8.23.1",
		"effect": "catalog:",
		"pg": "^8.23.1",
		"svelte": "catalog:",
		"svelte-check": "^4.7.7",
		"vite": "catalog:"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/norbital-ai/oss.git",
		"directory": "packages/bolt"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
