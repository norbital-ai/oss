{
	"name": "@norbital-ai/bolt",
	"version": "0.0.41",
	"description": "Bolt: the business OS framework — declarations, page SDK, protocol and the engine hosts run.",
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"license": "AGPL-3.0-only",
	"exports": {
		".": {
			"types": "./build/index.d.ts",
			"default": "./build/index.js"
		},
		"./errors": {
			"types": "./build/decl/errors.d.ts",
			"default": "./build/decl/errors.js"
		},
		"./page": {
			"types": "./build/page/index.d.ts",
			"svelte": "./build/page/index.js",
			"default": "./build/page/index.js"
		},
		"./engine": {
			"types": "./build/engine/index.d.ts",
			"default": "./build/engine/index.js"
		},
		"./artifact": {
			"types": "./build/engine/artifact/index.d.ts",
			"default": "./build/engine/artifact/index.js"
		},
		"./protocol": {
			"types": "./build/protocol/index.d.ts",
			"default": "./build/protocol/index.js"
		},
		"./host-api": {
			"types": "./build/host-api.d.ts",
			"default": "./build/host-api.js"
		},
		"./docs": {
			"types": "./build/docs/index.d.ts",
			"default": "./build/docs/index.js"
		},
		"./tooling": {
			"types": "./build/tooling/index.d.ts",
			"default": "./build/tooling/index.js"
		}
	},
	"files": [
		"build",
		"toolchain.json",
		"package.json"
	],
	"scripts": {
		"build": "node scripts/system-names.ts && node ../../scripts/build-package.ts svelte-package -i src -o {} --tsconfig tsconfig.json --then node scripts/docs.ts --then node scripts/cell-bundle.ts",
		"lint": "node scripts/system-names.ts && svelte-check --tsconfig ./tsconfig.json && tsgo -p tests/tsconfig.json --noEmit",
		"types:compat": "node scripts/system-names.ts && tsc -p tests/tsconfig.json --noEmit",
		"prepack": "pnpm exec turbo run build --filter=@norbital-ai/bolt"
	},
	"dependencies": {
		"@cfworker/json-schema": "4.1.1",
		"@effect/platform-node": "catalog:",
		"@electric-sql/pglite": "^0.5.12",
		"@iconify/svelte": "catalog:",
		"@jridgewell/trace-mapping": "^0.3.31",
		"@norbital-ai/host-api": "workspace:*",
		"@norbital-ai/store": "workspace:*",
		"@norbital-ai/ui": "workspace:*",
		"fflate": "0.8.3",
		"runed": "catalog:",
		"tailwindcss": "4.3.3",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"effect": "catalog:",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@iconify-json/lucide": "1.2.147",
		"@iconify-json/vscode-icons": "1.2.94",
		"@sveltejs/package": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "^26.6.5",
		"@types/pg": "^8.23.1",
		"effect": "catalog:",
		"fast-png": "8.0.0",
		"jpeg-js": "0.4.4",
		"pg": "^8.23.1",
		"rolldown": "1.2.15",
		"svelte": "catalog:",
		"svelte-check": "^4.7.7",
		"vite": "catalog:"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/norbital-ai/oss.git",
		"directory": "packages/bolt"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
