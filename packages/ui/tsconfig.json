{
	"extends": "@norbital-ai/config/svelte.json",
	"include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.svelte", "src/**/*.svelte.ts"],
	"exclude": ["node_modules", "**/__tests__/**", "build", "**/build/**"],
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"declaration": false,
		"declarationMap": false,
		"sourceMap": false,
		// UI's grid/virtualizer indexing is bounds-controlled at runtime, and Svelte component
		// wrappers deliberately forward optional props as undefined. These strictness flags produce
		// pervasive assertions/conditional spreads without strengthening those invariants.
		"noUncheckedIndexedAccess": false,
		"exactOptionalPropertyTypes": false,
		"types": ["node"],
		"customConditions": ["svelte"],
		"paths": {
			"#lib/*": ["./src/*"]
		}
	}
}
