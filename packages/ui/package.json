{
	"name": "@norbital-ai/ui",
	"version": "0.0.5",
	"description": "Svelte views, inputs, primitives, layout and design tokens for Bolt workspaces.",
	"type": "module",
	"sideEffects": false,
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/norbital-ai/oss.git",
		"directory": "packages/ui"
	},
	"homepage": "https://github.com/norbital-ai/oss/tree/main/packages/ui",
	"bugs": {
		"url": "https://github.com/norbital-ai/oss/issues"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"files": [
		"assets",
		"build",
		"package.json"
	],
	"exports": {
		".": {
			"types": "./build/index.d.ts",
			"svelte": "./build/index.js",
			"default": "./build/index.js"
		},
		"./layout": {
			"types": "./build/layout/index.d.ts",
			"svelte": "./build/layout/index.js",
			"default": "./build/layout/index.js"
		},
		"./brand": {
			"types": "./build/brand/index.d.ts",
			"svelte": "./build/brand/index.js",
			"default": "./build/brand/index.js"
		},
		"./capture": {
			"types": "./build/capture/index.d.ts",
			"svelte": "./build/capture/index.js",
			"default": "./build/capture/index.js"
		},
		"./effect": {
			"types": "./build/effect/index.d.ts",
			"svelte": "./build/effect/index.js",
			"default": "./build/effect/index.js"
		},
		"./base.css": "./build/base.css",
		"./brand/access.css": "./build/brand/access.css",
		"./assets/*": "./assets/*"
	},
	"scripts": {
		"build": "node ../../scripts/build-package.ts svelte-package -i src -o {}",
		"prepack": "pnpm exec turbo run build --filter=@norbital-ai/ui",
		"lint": "svelte-check --tsconfig tsconfig.json && svelte-check --tsconfig tests/tsconfig.json",
		"test": "vitest run"
	},
	"peerDependencies": {
		"svelte": "^5.56.10"
	},
	"peerDependenciesMeta": {
		"svelte": {
			"optional": false
		}
	},
	"dependencies": {
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/language": "^6.13.1",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@iconify/svelte": "catalog:",
		"@internationalized/date": "^3.12.4",
		"@lezer/highlight": "^1.2.5",
		"@norbital-ai/std": "workspace:*",
		"@tailwindcss/typography": "^0.5.20",
		"bits-ui": "^2.20.2",
		"clsx": "^2.1.1",
		"codemirror": "^6.0.2",
		"d3-shape": "^3.2.0",
		"effect": "catalog:",
		"fflate": "0.8.3",
		"layerchart": "2.9.1",
		"leaflet": "1.9.4",
		"marked": "18.1.2",
		"qrcode": "^1.5.4",
		"runed": "catalog:",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:",
		"@iconify-json/lucide": "1.2.147",
		"@sveltejs/package": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/d3-shape": "3.2.0",
		"@types/leaflet": "1.9.22",
		"@types/node": "^26.6.5",
		"@types/qrcode": "^1.5.6",
		"happy-dom": "^21.0.4",
		"prettier": "^3.9.10",
		"svelte": "catalog:",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "catalog:",
		"vitest": "5.0.5"
	}
}
