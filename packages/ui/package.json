{
	"name": "@norbital-ai/ui",
	"version": "0.0.5",
	"description": "Svelte component library and design tokens for Norbital tenant applications.",
	"type": "module",
	"sideEffects": false,
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/norbital-ai/oss.git",
		"directory": "packages/ui"
	},
	"homepage": "https://github.com/norbital-ai/oss/tree/main/packages/ui",
	"bugs": {
		"url": "https://github.com/norbital-ai/oss/issues"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"files": [
		"assets",
		"build",
		"src/base.css",
		"package.json"
	],
	"exports": {
		"./base.css": "./src/base.css",
		"./*": {
			"types": "./build/*/index.d.ts",
			"svelte": "./build/*/index.js",
			"default": "./build/*/index.js"
		},
		"./i18n": {
			"types": "./build/i18n/index.d.ts",
			"svelte": "./build/i18n/index.js",
			"default": "./build/i18n/index.js"
		},
		"./i18n/messages": {
			"types": "./build/i18n/messages/index.d.ts",
			"default": "./build/i18n/messages/index.js"
		},
		"./feature-colors": {
			"types": "./build/feature-colors/index.d.ts",
			"import": "./build/feature-colors/index.js",
			"default": "./build/feature-colors/index.js"
		},
		"./utils/*": {
			"types": "./build/utils/*.d.ts",
			"import": "./build/utils/*.js",
			"svelte": "./build/utils/*.js",
			"default": "./build/utils/*.js"
		},
		"./utils/pixel-drag.js": {
			"types": "./build/utils/pixel-drag.d.ts",
			"import": "./build/utils/pixel-drag.js",
			"svelte": "./build/utils/pixel-drag.js",
			"default": "./build/utils/pixel-drag.js"
		},
		"./code-editor/theme.js": {
			"types": "./build/code-editor/theme.d.ts",
			"import": "./build/code-editor/theme.js",
			"default": "./build/code-editor/theme.js"
		},
		"./assets/logo.svg": {
			"types": "./assets/logo.svg.d.ts",
			"default": "./assets/logo.svg"
		},
		"./assets/favicon/apple-icon.png": {
			"types": "./assets/favicon/apple-icon.png.d.ts",
			"default": "./assets/favicon/apple-icon.png"
		},
		"./assets/favicon/favicon-32x32.png": {
			"types": "./assets/favicon/favicon-32x32.png.d.ts",
			"default": "./assets/favicon/favicon-32x32.png"
		},
		"./assets/favicon/favicon.ico": {
			"types": "./assets/favicon/favicon.ico.d.ts",
			"default": "./assets/favicon/favicon.ico"
		},
		"./assets/*": {
			"default": "./assets/*"
		}
	},
	"imports": {
		"#lib/ai-elements/shimmer": "./build/ai-elements/shimmer/index.js",
		"#lib/collection-table/internal": "./build/collection-table/internal/index.js",
		"#lib/i18n/messages": "./build/i18n/messages/index.js",
		"#lib/ai-elements/*": "./build/ai-elements/*.js",
		"#lib/carousel/*": "./build/carousel/*.js",
		"#lib/chart/*": "./build/chart/*.js",
		"#lib/code-editor/*": "./build/code-editor/*.js",
		"#lib/collection-form/*": "./build/collection-form/*.js",
		"#lib/collection-kanban/*": "./build/collection-kanban/*.js",
		"#lib/collection-navigation/*": "./build/collection-navigation/*.js",
		"#lib/collection-record-metadata/*": "./build/collection-record-metadata/*.js",
		"#lib/collection-table/*": "./build/collection-table/*.js",
		"#lib/collection-toolbar/*": "./build/collection-toolbar/*.js",
		"#lib/combobox/*": "./build/combobox/*.js",
		"#lib/command/*": "./build/command/*.js",
		"#lib/country-picker/*": "./build/country-picker/*.js",
		"#lib/data-renderer/*": "./build/data-renderer/*.js",
		"#lib/doc-toc/*": "./build/doc-toc/*.js",
		"#lib/event-calendar/*": "./build/event-calendar/*.js",
		"#lib/file-tree/*": "./build/file-tree/*.js",
		"#lib/file-value/*": "./build/file-value/*.js",
		"#lib/form/*": "./build/form/*.js",
		"#lib/i18n/*": "./build/i18n/*.js",
		"#lib/icon-wrapper/*": "./build/icon-wrapper/*.js",
		"#lib/indicator/*": "./build/indicator/*.js",
		"#lib/layout/*": "./build/layout/*.js",
		"#lib/multi-step-combobox/*": "./build/multi-step-combobox/*.js",
		"#lib/product-icon/*": "./build/product-icon/*.js",
		"#lib/sheet/*": "./build/sheet/*.js",
		"#lib/sidebar/*": "./build/sidebar/*.js",
		"#lib/star-rating/*": "./build/star-rating/*.js",
		"#lib/static-map/*": "./build/static-map/*.js",
		"#lib/step-form/*": "./build/step-form/*.js",
		"#lib/tabs/*": "./build/tabs/*.js",
		"#lib/tags-input/*": "./build/tags-input/*.js",
		"#lib/time-range/*": "./build/time-range/*.js",
		"#lib/utils/*": "./build/utils/*.js",
		"#lib/workspace-shell/*": "./build/workspace-shell/*.js",
		"#lib/*": "./build/*/index.js"
	},
	"scripts": {
		"build": "node ../../scripts/build-package.mjs svelte-package -i src -o {}",
		"prepack": "pnpm exec turbo run build --filter=@norbital-ai/ui",
		"lint": "svelte-check --tsconfig tsconfig.json && tsc -p tests/tsconfig.json --noEmit",
		"test": "node --experimental-strip-types --test tests/*.test.ts"
	},
	"peerDependencies": {
		"@norbital-ai/std": "workspace:*",
		"effect": "4.0.0-rc.112",
		"svelte": "^5.56.10"
	},
	"peerDependenciesMeta": {
		"svelte": {
			"optional": false
		}
	},
	"dependencies": {
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/lang-yaml": "^6.1.3",
		"@codemirror/language": "^6.12.4",
		"@codemirror/state": "^6.7.1",
		"@codemirror/view": "^6.43.9",
		"@floating-ui/dom": "^1.8.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@iconify/svelte": "catalog:",
		"@internationalized/date": "^3.12.3",
		"@lezer/highlight": "^1.2.3",
		"@tailwindcss/typography": "^0.5.20",
		"@tiptap/core": "^3.30.2",
		"@tiptap/extension-bubble-menu": "^3.30.2",
		"@tiptap/extension-code-block": "^3.30.2",
		"@tiptap/extension-code-block-lowlight": "^3.30.2",
		"@tiptap/extension-list": "^3.30.2",
		"@tiptap/extension-mention": "^3.30.2",
		"@tiptap/extension-placeholder": "^3.30.2",
		"@tiptap/extension-table": "^3.30.2",
		"@tiptap/extension-task-item": "^3.30.2",
		"@tiptap/extension-task-list": "^3.30.2",
		"@tiptap/extensions": "^3.30.2",
		"@tiptap/markdown": "^3.30.2",
		"@tiptap/pm": "^3.30.2",
		"@tiptap/starter-kit": "^3.30.2",
		"@tiptap/suggestion": "^3.30.2",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"codemirror": "^6.0.2",
		"date-fns": "^4.4.0",
		"dedent": "^1.7.2",
		"embla-carousel-svelte": "^8.6.0",
		"es-toolkit": "^1.51.0",
		"highlight.js": "^11.12.0",
		"layerchart": "2.3.0",
		"leaflet": "1.9.4",
		"libphonenumber-js": "^1.13.11",
		"lowlight": "^3.3.0",
		"marked": "18.0.10",
		"mode-watcher": "^1.1.0",
		"papaparse": "^5.6.0",
		"prosemirror-model": "^1.25.11",
		"prosemirror-view": "^1.42.2",
		"runed": "catalog:",
		"sortablejs": "^1.15.7",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tippy.js": "^6.3.7",
		"tw-animate-css": "^1.4.0",
		"vaul-svelte": "1.0.0-next.7"
	},
	"devDependencies": {
		"@norbital-ai/config": "workspace:*",
		"@norbital-ai/std": "workspace:*",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/leaflet": "1.9.22",
		"@types/node": "^26.2.0",
		"@types/papaparse": "^5.5.2",
		"@types/sortablejs": "^1.15.9",
		"prettier": "^3.9.6",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "catalog:"
	}
}
