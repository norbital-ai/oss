{
	"name": "@norbital-ai/ui",
	"version": "0.0.151",
	"description": "Svelte views, inputs, primitives, layout and design tokens for Bolt workspaces.",
	"type": "module",
	"sideEffects": false,
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/norbital-ai/oss.git",
		"directory": "packages/ui"
	},
	"homepage": "https://github.com/norbital-ai/oss/tree/main/packages/ui",
	"bugs": {
		"url": "https://github.com/norbital-ai/oss/issues"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"files": [
		"assets",
		"build",
		"package.json"
	],
	"exports": {
		".": {
			"types": "./build/index.d.ts",
			"svelte": "./build/index.js",
			"default": "./build/index.js"
		},
		"./layout": {
			"types": "./build/layout/index.d.ts",
			"svelte": "./build/layout/index.js",
			"default": "./build/layout/index.js"
		},
		"./brand": {
			"types": "./build/brand/index.d.ts",
			"svelte": "./build/brand/index.js",
			"default": "./build/brand/index.js"
		},
		"./capture": {
			"types": "./build/views/capture/index.d.ts",
			"svelte": "./build/views/capture/index.js",
			"default": "./build/views/capture/index.js"
		},
		"./base.css": "./build/base.css",
		"./assets/*": "./assets/*"
	},
	"scripts": {
		"build": "node ../../scripts/build-package.mjs svelte-package -i src -o {}",
		"prepack": "pnpm exec turbo run build --filter=@norbital-ai/ui",
		"lint": "svelte-check --tsconfig tsconfig.json && tsc -p tests/tsconfig.json --noEmit",
		"test": "node --experimental-strip-types --test tests/*.test.ts"
	},
	"peerDependencies": {
		"svelte": "^5.56.10"
	},
	"peerDependenciesMeta": {
		"svelte": {
			"optional": false
		}
	},
	"dependencies": {
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/language": "^6.12.4",
		"@codemirror/state": "^6.7.1",
		"@codemirror/view": "^6.43.9",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@iconify/svelte": "catalog:",
		"@internationalized/date": "^3.12.3",
		"@lezer/highlight": "^1.2.3",
		"@norbital-ai/std": "workspace:*",
		"@tailwindcss/typography": "^0.5.20",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"codemirror": "^6.0.2",
		"layerchart": "2.3.0",
		"leaflet": "1.9.4",
		"marked": "18.0.10",
		"qrcode": "^1.5.4",
		"runed": "catalog:",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/leaflet": "1.9.22",
		"@types/node": "^26.2.0",
		"@types/qrcode": "^1.5.6",
		"prettier": "^3.9.6",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "catalog:"
	}
}
