{
	"name": "@norbital-ai/providers",
	"version": "0.0.36",
	"description": "Bolt's built-in integration drivers (WhatsApp via Web or Twilio, Telegram, Slack, Discord, WeChat, IMAP + SMTP mailboxes, Google Calendar), registered by a host.",
	"type": "module",
	"sideEffects": false,
	"license": "AGPL-3.0-only",
	"exports": {
		".": {
			"types": "./build/index.d.ts",
			"default": "./build/index.js"
		},
		"./abi": {
			"types": "./build/abi.d.ts",
			"default": "./build/abi.js"
		},
		"./errors": {
			"types": "./build/errors.d.ts",
			"default": "./build/errors.js"
		},
		"./simulator": {
			"types": "./build/simulator/index.d.ts",
			"default": "./build/simulator/index.js"
		},
		"./openrouter": {
			"types": "./build/openrouter/index.d.ts",
			"default": "./build/openrouter/index.js"
		}
	},
	"files": [
		"build",
		"package.json"
	],
	"scripts": {
		"build": "node ../../scripts/build-package.ts tsc -p tsconfig.json --outDir {}",
		"lint": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
		"prepack": "pnpm exec turbo run build --filter=@norbital-ai/providers"
	},
	"dependencies": {
		"@norbital-ai/bolt": "workspace:*",
		"effect": "catalog:",
		"imapflow": "2.9.1",
		"nodemailer": "10.2.1",
		"postal-mime": "4.1.4"
	},
	"optionalDependencies": {
		"@whiskeysockets/baileys": "7.0.0-rc14"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:",
		"@getdial/sdk": "0.19.1",
		"@googleapis/chat": "44.7.0",
		"@larksuiteoapi/node-sdk": "1.76.0",
		"@line/bot-sdk": "11.0.0",
		"@linear/sdk": "76.0.0",
		"@linqapp/sdk": "0.47.1",
		"@liveblocks/node": "3.24.5",
		"@microsoft/teams.api": "2.1.1",
		"@microsoft/teams.apps": "2.1.1",
		"@octokit/rest": "22.0.1",
		"@spectrum-ts/core": "10.0.0",
		"@spectrum-ts/imessage": "10.0.0",
		"@types/node": "^26.6.5",
		"@xdevplatform/chat-xdk": "0.4.3",
		"@xdevplatform/xdk": "0.6.6",
		"google-auth-library": "10.5.0",
		"juicebox-sdk": "0.3.7",
		"resend": "6.37.0",
		"sendblue": "3.21.2",
		"typescript": "catalog:"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/norbital-ai/oss.git",
		"directory": "packages/providers"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"peerDependencies": {
		"@getdial/sdk": "0.19.1",
		"@googleapis/chat": "44.7.0",
