{
	"name": "@norbital-ai/host-api",
	"version": "0.0.42",
	"description": "The Host API: the versioned contract between a host and a Bolt release — HOST_API version and range, port types, boundary Schemas, a conformance kit and the Node port implementations every host shares (`./node`).",
	"type": "module",
	"sideEffects": false,
	"license": "AGPL-3.0-only",
	"exports": {
		".": {
			"types": "./build/index.d.ts",
			"default": "./build/index.js"
		},
		"./node": {
			"types": "./build/node.d.ts",
			"default": "./build/node.js"
		}
	},
	"files": [
		"build",
		"package.json"
	],
	"scripts": {
		"build": "node ../../scripts/build-package.ts tsc -p tsconfig.json --outDir {}",
		"lint": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
		"prepack": "pnpm exec turbo run build --filter=@norbital-ai/host-api"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:",
		"@electric-sql/pglite": "^0.5.12",
		"@electric-sql/pglite-pgvector": "^0.0.13",
		"@jridgewell/trace-mapping": "^0.3.31",
		"@modelcontextprotocol/client": "2.4.0",
		"@norbital-ai/store": "workspace:*",
		"@typescript/native": "npm:typescript@7.0.2",
		"effect": "catalog:",
		"exifr": "7.1.3",
		"fast-png": "8.0.0",
		"jpeg-js": "0.4.4",
		"libheif-js": "1.23.5",
		"pdq-wasm": "0.3.9",
		"rolldown": "1.2.15",
		"svelte2tsx": "0.7.62",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:",
		"@types/node": "^26.6.5",
		"vitest": "5.0.5"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/norbital-ai/oss.git",
		"directory": "packages/host-api"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
