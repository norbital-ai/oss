{
	"$schema": "https://turbo.build/schema.json",
	// Every package's `build` shells out to `scripts/build-package.ts`, which lives outside all of
	// them — so edits to it, or to the emit checks it imports, change what a build produces without
	// changing any package's own inputs. Without these entries turbo replays a cache entry from
	// before the change and the new check never runs.
	"globalDependencies": [
		"tsconfig.base.json",
		"**/.env.*local",
		"scripts/build-package.ts",
		"scripts/lib/declaration-emit.ts",
		"scripts/lib/error.ts"
	],
	"globalPassThroughEnv": ["CI"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				".env*",
				"!build/**",
				"!.generated/**",
				"!.norbital/dist/**",
				"!.svelte-kit/**",
				"!.vercel/**"
			],
			"outputs": ["build/**", ".generated/**", ".norbital/dist/**", ".svelte-kit/**", ".vercel/**"]
		},
		"lint": {
			"dependsOn": ["^build", "^lint"]
		},
		"types:compat": {
			"dependsOn": ["^build"]
		}
	}
}
