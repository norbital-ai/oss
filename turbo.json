{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": ["**/.env.*local"],
	"globalPassThroughEnv": ["CI"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				".env*",
				"!build/**",
				"!.generated/**",
				"!.norbital/dist/**",
				"!.svelte-kit/**",
				"!.vercel/**"
			],
			"outputs": ["build/**", ".generated/**", ".norbital/dist/**", ".svelte-kit/**", ".vercel/**"]
		},
		"lint": {
			"dependsOn": ["^build", "^lint"]
		},
		"test": {
			// A package's own build, not just its dependencies'. Pod's runtime harness executes
			// `build/bin/invocation/index.js` to build a template, and platform-utils asserts over its
			// build output — so without this, `turbo test` runs those suites against whatever `build/`
			// happens to be there. Worse, `build` opens with `rm -rf build`, so an unordered pair
			// deletes the binary a running test is executing.
			"dependsOn": ["^build", "build", "^test"]
		}
	}
}
