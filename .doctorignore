# Borrow what this repository already declares is not source, rather than restating it.
inherit: .gitignore .prettierignore

# norbital-doctor's own source is checked, with four rules scoped out.
#
# It ships as a standalone Node CLI and must run in repositories that have no Effect runtime —
# analysing one is its job. So Effect-owned control flow (EFF1-EFF3) and the blocking-IO rule (IO1)
# describe an architecture it is deliberately outside of. Every other rule still applies.
packages/doctor/src/  EFF1 EFF2 EFF3 IO1 NODE1 NODE2

# Node CLIs and package scripts sit outside Effect ownership the same way doctor does.
scripts/  A1 A6 EFF1 EFF2 EFF3 COMPLEX1 D1 E1 EQ1 SQL1 NODE1 NODE2 NODE3 R6b S1 STATE1 PERF3 LIVE1 LOG1

# Isolate HTTP and the compiler are the native async edge of an Effect
# runtime. Same family packages/doctor/src already scopes out.
packages/bolt-server/src/  EFF3 COMPLEX1
packages/bolt/src/compiler/  A6 EFF1 EFF2 EFF3 AL9 R3e COMPLEX1
packages/bolt/src/client/  EFF2 LOG1 AL9 R3a R3b NONDET1 STATE1 COMPLEX1 D1
packages/ui/src/  R1 R3b LEGACY2 D1
