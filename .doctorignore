# Borrow what this repository already declares is not source, rather than restating it.
inherit: .gitignore .prettierignore

# The ignore reader ships as plain Node scripts beside the runtime's needs.
packages/doctor/engine/

# The old engine ported byte-faithfully into typed source while its release-gate output was
# proven byte-identical. Refactoring those modules to the hygiene rules (guard clauses, shape
# decoders, dead-export pruning) would diverge the port from the evidence that proved it, so
# the same families the engine directory was scoped for carry across to the port. This line
# lapses when the port's byte-parity fixtures are retired.
packages/doctor/src/analysis/  EXP1 PERF3 LEGACY2 D1 R3a R5d R6a R6b EQ1 COMPLEX1 NO_TRYCATCH

# norbital-doctor's own source is checked, with four rules scoped out.
#
# It ships as a standalone Node CLI and must run in repositories that have no Effect runtime —
# analysing one is its job. So Effect-owned control flow (EFF1-EFF3) and the blocking-IO rule (IO1)
# describe an architecture it is deliberately outside of. Every other rule still applies.
packages/doctor/src/  EFF1 EFF2 EFF3 IO1
