{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/norbital-ai/oss/blob/main/release/builder-toolchain-verification.schema.json",
	"title": "Norbital builder toolchain verification",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"$schema",
		"schemaVersion",
		"image",
		"packageKey",
		"templateDependencyKey",
		"platformManifest",
		"network",
		"staticVerificationMemoryLimitBytes",
		"buildMemoryLimitBytes",
		"templates",
		"passed"
	],
	"properties": {
		"$schema": { "const": "../release/builder-toolchain-verification.schema.json" },
		"schemaVersion": { "const": 1 },
		"image": {
			"type": "string",
			"pattern": "^.+@sha256:[0-9a-f]{64}$"
		},
		"packageKey": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
		"templateDependencyKey": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
		"platformManifest": { "const": "/opt/norbital/platform-client/platform-manifest.json" },
		"network": { "const": "none" },
		"staticVerificationMemoryLimitBytes": { "const": 1073741824 },
		"buildMemoryLimitBytes": { "const": 524288000 },
		"templates": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["key", "elapsedMilliseconds", "passed"],
				"properties": {
					"key": { "type": "string", "minLength": 1 },
					"elapsedMilliseconds": { "type": "number", "minimum": 0 },
					"passed": { "const": true }
				}
			}
		},
		"passed": { "const": true }
	}
}
