{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/norbital-ai/oss/blob/main/release/builder-benchmark.schema.json",
	"title": "Norbital compile budget",
	"description": "The compile budget measured on a fixed runner against a materialized depset. This is compileMs only. deployColdMs and deployCacheHitMs are live SLOs measured against a real tenant deploy and are not comparable to this number.",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"$schema",
		"schemaVersion",
		"measures",
		"template",
		"lockHash",
		"depsetMaterialized",
		"materializeMilliseconds",
		"buildCommand",
		"buildEnvironment",
		"elapsedMilliseconds",
		"maximumBuildMilliseconds",
		"requiredOutputPresent",
		"migrationSqlCount",
		"passed"
	],
	"properties": {
		"$schema": { "const": "../release/builder-benchmark.schema.json" },
		"schemaVersion": { "const": 4 },
		"measures": { "const": "compileMs" },
		"template": { "type": "string", "minLength": 1 },
		"lockHash": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
		"depsetMaterialized": { "type": "boolean" },
		"materializeMilliseconds": { "type": "number", "minimum": 0 },
		"buildCommand": { "const": "vite build" },
		"buildEnvironment": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"MALLOC_ARENA_MAX",
				"MALLOC_TRIM_THRESHOLD_",
				"NODE_OPTIONS",
				"NORBITAL_POD_SYNCED",
				"NORBITAL_POD_CHECKED"
			],
			"properties": {
				"MALLOC_ARENA_MAX": { "const": "1" },
				"MALLOC_TRIM_THRESHOLD_": { "const": "131072" },
				"NODE_OPTIONS": { "const": "--max-old-space-size=192" },
				"NORBITAL_POD_SYNCED": { "const": "1" },
				"NORBITAL_POD_CHECKED": { "const": "1" }
			}
		},
		"elapsedMilliseconds": { "type": "number", "minimum": 0, "maximum": 5000 },
		"maximumBuildMilliseconds": { "const": 5000 },
		"requiredOutputPresent": { "const": true },
		"migrationSqlCount": { "type": "integer", "minimum": 1 },
		"passed": { "const": true }
	}
}
