{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/norbital-ai/oss/blob/main/release/builder-benchmark.schema.json",
	"title": "Norbital builder benchmark",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"$schema",
		"schemaVersion",
		"image",
		"packageKey",
		"template",
		"network",
		"warm",
		"prevalidated",
		"staticVerification",
		"buildCommand",
		"buildEnvironment",
		"elapsedMilliseconds",
		"maximumBuildMilliseconds",
		"memoryLimitBytes",
		"memorySwapLimitBytes",
		"peakMemoryBytes",
		"peakScope",
		"passed"
	],
	"properties": {
		"$schema": { "const": "../release/builder-benchmark.schema.json" },
		"schemaVersion": { "const": 2 },
		"image": {
			"type": "string",
			"pattern": "^.+@sha256:[0-9a-f]{64}$"
		},
		"packageKey": {
			"type": "string",
			"pattern": "^[0-9a-f]{16}$"
		},
		"template": { "type": "string", "minLength": 1 },
		"network": { "const": "none" },
		"warm": { "const": true },
		"prevalidated": { "const": true },
		"staticVerification": { "const": "builder-toolchain-verification.json" },
		"buildCommand": { "const": "env NORBITAL_POD_CHECKED=1 vite build /workspace" },
		"buildEnvironment": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"MALLOC_ARENA_MAX",
				"MALLOC_TRIM_THRESHOLD_",
				"NODE_OPTIONS",
				"NORBITAL_BUILD_OUT",
				"NORBITAL_POD_PLATFORM_DIR",
				"NORBITAL_POD_SYNCED",
				"NORBITAL_POD_CHECKED"
			],
			"properties": {
				"MALLOC_ARENA_MAX": { "const": "1" },
				"MALLOC_TRIM_THRESHOLD_": { "const": "131072" },
				"NODE_OPTIONS": { "const": "--max-old-space-size=192" },
				"NORBITAL_BUILD_OUT": { "const": "/workspace/.norbital/dist/output" },
				"NORBITAL_POD_PLATFORM_DIR": { "const": "/opt/norbital/platform-client" },
				"NORBITAL_POD_SYNCED": { "const": "1" },
				"NORBITAL_POD_CHECKED": { "const": "1" }
			}
		},
		"elapsedMilliseconds": { "type": "number", "minimum": 0, "maximum": 5000 },
		"maximumBuildMilliseconds": { "const": 5000 },
		"memoryLimitBytes": { "const": 524288000 },
		"memorySwapLimitBytes": { "const": 524288000 },
		"peakMemoryBytes": {
			"anyOf": [{ "type": "integer", "minimum": 0, "maximum": 524288000 }, { "type": "null" }]
		},
		"peakScope": {
			"enum": ["measured-build", "warm-up-and-measured-build"]
		},
		"passed": { "const": true }
	}
}
