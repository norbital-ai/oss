{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/norbital-ai/oss/blob/main/release/runtime-smoke.schema.json",
	"title": "Norbital published runtime smoke evidence",
	"description": "Evidence that a build against a materialized depset produces a function-guest bundle (dispatch / registerPodHostPlugins). The bundle format is the only cross-version contract now that there are no images.",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"$schema",
		"schemaVersion",
		"template",
		"lockHash",
		"buildCommand",
		"buildElapsedMilliseconds",
		"requiredBundlePaths",
		"migrationSqlCount",
		"runtimeEntry",
		"serveEntrySha256",
		"passed"
	],
	"properties": {
		"$schema": { "const": "../release/runtime-smoke.schema.json" },
		"schemaVersion": { "const": 3 },
		"template": { "type": "string", "minLength": 1 },
		"lockHash": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
		"buildCommand": { "const": "vite build" },
		"buildElapsedMilliseconds": { "type": "number", "minimum": 0 },
		"requiredBundlePaths": {
			"const": [
				"manifest.json",
				"dist/index.html",
				"output/server/index.js",
				"schema-functions.sql",
				"schema-post-ddl.sql"
			]
		},
		"migrationSqlCount": { "type": "integer", "minimum": 1 },
		"runtimeEntry": { "const": "output/server/index.js" },
		"serveEntrySha256": {
			"type": "string",
			"pattern": "^[0-9a-f]{64}$"
		},
		"passed": { "const": true }
	}
}
