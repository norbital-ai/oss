{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/norbital-ai/oss/blob/main/release/runtime-smoke.schema.json",
	"title": "Norbital published runtime smoke evidence",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"$schema",
		"schemaVersion",
		"builderImage",
		"runtimeImage",
		"packageKey",
		"template",
		"network",
		"buildMemoryLimitBytes",
		"runtimeMemoryLimitBytes",
		"buildCommand",
		"buildElapsedMilliseconds",
		"requiredBundlePaths",
		"migrationSqlCount",
		"runtimeEntry",
		"serveEntrySha256",
		"readyFrame",
		"passed"
	],
	"properties": {
		"$schema": { "const": "../release/runtime-smoke.schema.json" },
		"schemaVersion": { "const": 2 },
		"builderImage": {
			"type": "string",
			"pattern": "^.+@sha256:[0-9a-f]{64}$"
		},
		"runtimeImage": {
			"type": "string",
			"pattern": "^.+@sha256:[0-9a-f]{64}$"
		},
		"packageKey": {
			"type": "string",
			"pattern": "^[0-9a-f]{16}$"
		},
		"template": { "type": "string", "minLength": 1 },
		"network": { "const": "none" },
		"buildMemoryLimitBytes": { "const": 524288000 },
		"runtimeMemoryLimitBytes": { "const": 524288000 },
		"buildCommand": { "const": "env NORBITAL_POD_CHECKED=1 vite build /workspace" },
		"buildElapsedMilliseconds": { "type": "number", "minimum": 0 },
		"requiredBundlePaths": {
			"const": [
				"manifest.json",
				"dist/index.html",
				"serve.mjs",
				"output/server/index.js",
				"schema-functions.sql",
				"schema-post-ddl.sql"
			]
		},
		"migrationSqlCount": { "type": "integer", "minimum": 1 },
		"runtimeEntry": { "const": "/app/serve.mjs" },
		"serveEntrySha256": {
			"type": "string",
			"pattern": "^[0-9a-f]{64}$"
		},
		"readyFrame": {
			"type": "object",
			"additionalProperties": false,
			"required": ["t"],
			"properties": {
				"t": { "const": "ready" }
			}
		},
		"passed": { "const": true }
	}
}
