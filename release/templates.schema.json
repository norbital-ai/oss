{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/norbital-ai/oss/blob/main/release/templates.schema.json",
	"title": "Norbital template projection catalogue",
	"type": "object",
	"additionalProperties": false,
	"required": ["schemaVersion", "refNamespace", "templates"],
	"properties": {
		"$schema": { "type": "string" },
		"schemaVersion": { "const": 1 },
		"refNamespace": {
			"type": "string",
			"pattern": "^refs/heads/[a-z0-9][a-z0-9._/-]*[a-z0-9]$"
		},
		"templates": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"key",
					"path",
					"name",
					"industry",
					"description",
					"visibility",
					"counts",
					"compatiblePod"
				],
				"properties": {
					"key": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
					"path": {
						"type": "string",
						"pattern": "^template_workspaces/[a-z0-9]+(?:-[a-z0-9]+)*$"
					},
					"name": { "type": "string", "minLength": 1 },
					"industry": { "type": "string", "minLength": 1 },
					"description": { "type": "string", "minLength": 1 },
					"visibility": { "enum": ["public", "unlisted"] },
					"counts": {
						"type": "object",
						"additionalProperties": false,
						"required": ["collections", "apps", "automations"],
						"properties": {
							"collections": { "type": "integer", "minimum": 0 },
							"apps": { "type": "integer", "minimum": 0 },
							"automations": { "type": "integer", "minimum": 0 }
						}
					},
					"compatiblePod": { "type": "string", "minLength": 1 }
				}
			}
		}
	}
}
