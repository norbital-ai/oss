{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/norbital-ai/oss/blob/main/release/platform-release.schema.json",
	"title": "Norbital platform release",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schemaVersion",
		"releaseId",
		"buildContractId",
		"createdAt",
		"source",
		"packages",
		"templates",
		"images",
		"compatibility"
	],
	"properties": {
		"$schema": { "type": "string" },
		"schemaVersion": { "const": 1 },
		"releaseId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
		"buildContractId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
		"createdAt": { "type": "string", "format": "date-time" },
		"source": {
			"type": "object",
			"additionalProperties": false,
			"required": ["repository", "revision"],
			"properties": {
				"repository": { "type": "string", "minLength": 1 },
				"revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
			}
		},
		"packages": {
			"type": "object",
			"additionalProperties": false,
			"required": ["registry", "packageKey", "entries"],
			"properties": {
				"registry": { "type": "string", "minLength": 1 },
				"packageKey": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
				"entries": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["name", "version"],
						"properties": {
							"name": { "type": "string", "pattern": "^@norbital-ai/" },
							"version": { "type": "string", "minLength": 1 }
						}
					}
				}
			}
		},
		"templates": {
			"type": "object",
			"additionalProperties": false,
			"required": ["repository", "entries"],
			"properties": {
				"repository": { "type": "string", "minLength": 1 },
				"entries": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": [
							"key",
							"ref",
							"revision",
							"name",
							"industry",
							"description",
							"visibility",
							"counts",
							"compatiblePod"
						],
						"properties": {
							"key": { "type": "string" },
							"ref": { "type": "string", "pattern": "^refs/heads/" },
							"revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
							"name": { "type": "string", "minLength": 1 },
							"industry": { "type": "string", "minLength": 1 },
							"description": { "type": "string", "minLength": 1 },
							"visibility": { "enum": ["public", "unlisted"] },
							"counts": {
								"type": "object",
								"additionalProperties": false,
								"required": ["collections", "apps", "automations"],
								"properties": {
									"collections": { "type": "integer", "minimum": 0 },
									"apps": { "type": "integer", "minimum": 0 },
									"automations": { "type": "integer", "minimum": 0 }
								}
							},
							"compatiblePod": { "type": "string" }
						}
					}
				}
			}
		},
		"images": {
			"type": "object",
			"additionalProperties": false,
			"required": ["builder", "runtime"],
			"properties": {
				"builder": { "$ref": "#/$defs/image" },
				"runtime": { "$ref": "#/$defs/image" }
			}
		},
		"compatibility": {
			"type": "object",
			"additionalProperties": false,
			"required": ["compilerContract", "node", "pod"],
			"properties": {
				"compilerContract": { "type": "integer", "minimum": 1 },
				"node": { "type": "string" },
				"pod": { "type": "string" }
			}
		}
	},
	"$defs": {
		"image": {
			"type": "object",
			"additionalProperties": false,
			"required": ["reference", "digest"],
			"properties": {
				"reference": { "type": "string", "minLength": 1 },
				"digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
			}
		}
	}
}
