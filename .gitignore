.turbo/
coverage/
test-results/
playwright-report/
.tmp/

# Local yalc store
**/.yalc/
**/yalc.lock

# Environment and local files
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
*.log
vite.config.*.timestamp-*

# Scratch workspaces for manual and end-to-end runs.
.test-workspaces/

