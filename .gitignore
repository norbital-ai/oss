# Dependencies
node_modules/
.local-packages/

# Generated package and release archives
/dist/
*.tgz
*.tar
*.tar.gz

# Package-manager lockfiles other than the committed pnpm lockfile
**/package-lock.json
**/yarn.lock

# Build output
**/build/
**/build.staging/
**/build.retired/
**/.svelte-kit/
**/.generated/
# Generated workspace state. Migrations and doctor configuration are authored and stay tracked.
**/.norbital/*
!**/.norbital/migrations/
!**/.norbital/migrations/**
!**/.norbital/config/
!**/.norbital/config/**
*.tsbuildinfo

# Tool caches and reports
.turbo/
coverage/
test-results/
playwright-report/
.tmp/

# Local yalc store
**/.yalc/
**/yalc.lock

# Environment and local files
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
*.log
vite.config.*.timestamp-*

# Scratch workspaces for manual and end-to-end runs.
.test-workspaces/

# Agent worktrees: a working copy of this repo, never part of it.
#
# `**/` is load-bearing. A pattern with an internal slash is anchored to this file's directory,
# so the bare `.claude/worktrees/` matched only the repo root — and agents create worktrees under
# the package they are working in (`packages/bolt/.claude/worktrees/…`), which stayed untracked
# and got committed once as a gitlink: a submodule pointer to a branch that exists on no remote.
**/.claude/worktrees/
