{
	"$schema": "https://typedoc.org/schema.json",
	"name": "Norbital API Reference",
	"plugin": ["typedoc-plugin-markdown"],
	"tsconfig": "typedoc.registry.tsconfig.json",
	"entryPoints": ["packages/std/build", "packages/ui/build"],
	"entryPointStrategy": "expand",
	"excludeExternals": true,
	"excludeInternal": true,
	"excludePrivate": true,
	"excludeProtected": true,
	"skipErrorChecking": true,
	"packagesRequiringDocumentation": ["@norbital-ai/std", "@norbital-ai/ui"],
	"validation": {
		"invalidLink": false,
		"notDocumented": false,
		"notExported": false
	},
	"treatWarningsAsErrors": false,
	"readme": "none",
	"out": "docs/api-reference",
	"router": "module",
	"publicPath": "/docs/api-reference/",
	"includeVersion": true,
	"useCodeBlocks": true,
	"parametersFormat": "table",
	"typeAliasPropertiesFormat": "table",
	"useHTMLAnchors": true,
	"searchInComments": true,
	"useFirstParagraphOfCommentAsSummary": true,
	"cleanOutputDir": true
}
