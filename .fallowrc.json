{
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
	"entry": [
		"packages/*/svelte.config.js",
		"packages/*/vite.config.ts",
		"packages/*/vitest.config.ts",
		"packages/bolt-protocol/src/bundle.ts",
		"packages/bolt-protocol/src/facilities.ts",
		"packages/bolt-protocol/src/index.ts",
		"packages/bolt-protocol/src/invocation.ts",
		"packages/bolt-protocol/src/wire.ts",
		"packages/bolt-server/src/index.ts",
		"packages/bolt/src/authoring/index.ts",
		"packages/bolt/src/authoring/internals.ts",
		"packages/bolt/src/client.ts",
		"packages/bolt/src/client/identity.ts",
		"packages/bolt/src/client/runtime.ts",
		"packages/bolt/src/client/ui/collection/detail-surface.ts",
		"packages/bolt/src/client/ui/settings/table-client.ts",
		"packages/bolt/src/client/ui/shell/header-actions.svelte",
		"packages/bolt/src/client/ui/state/files.ts",
		"packages/bolt/src/client/ui/state/import-export.ts",
		"packages/bolt/src/client/ui/state/platform.ts",
		"packages/bolt/src/compiler/cli.ts",
		"packages/bolt/src/compiler/vite-plugin.ts",
		"packages/bolt/src/host.ts",
		"packages/bolt/src/index.ts",
		"packages/bolt/src/quality/audit.ts",
		"packages/bolt/src/runtime/app.ts",
		"packages/std/src/async/index.ts",
		"packages/std/src/billing/index.ts",
		"packages/std/src/cache/index.ts",
		"packages/std/src/cel/index.ts",
		"packages/std/src/collection/index.ts",
		"packages/std/src/date/index.ts",
		"packages/std/src/error/index.ts",
		"packages/std/src/finance/index.ts",
		"packages/std/src/i18n/index.ts",
		"packages/std/src/index.ts",
		"packages/std/src/json/index.ts",
		"packages/std/src/rate-limit/index.ts",
		"packages/std/src/reckon/index.ts",
		"packages/std/src/secret/index.ts",
		"packages/std/src/string/index.ts",
		"packages/std/src/text/dedent/index.ts",
		"packages/std/src/text/index.ts",
		"packages/std/src/tree/index.ts",
		"packages/std/src/truncate/index.ts",
		"packages/ui/src/**/*.svelte",
		"packages/ui/src/**/*.ts",
		"packages/ui/src/**/*/index.svelte",
		"packages/ui/src/**/*/index.ts",
		"packages/ui/src/code-editor/theme.ts",
		"packages/ui/src/collection-table/collection-table-navigation.svelte.ts",
		"packages/ui/src/feature-colors/index.ts",
		"packages/ui/src/utils/**/*.svelte",
		"packages/ui/src/utils/**/*.ts",
		"packages/ui/src/utils/pixel-drag.ts",
		"scripts/*.mjs"
	],
	"rules": {
		"unused-exports": "off",
		"unused-types": "off",
		"unused-class-members": "off",
		"duplicate-exports": "off",
		"circular-dependencies": "off",
		"unused-files": "error",
		"unused-dependencies": "error",
		"unlisted-dependencies": "error"
	},
	"ignorePatterns": [
		"**/.svelte-kit/**",
		"**/build/**",
		"**/.norbital/**",
		"**/coverage/**",
		"**/test-results/**",
		"**/playwright-report/**",
		"**/*.test-d.ts",
		"**/.generated/**",
		"release/**"
	],
	"duplicates": {
		"ignore": [
			"**/node_modules/**",
			"**/build/**",
			"**/.svelte-kit/**",
			"**/*.test.ts",
			"**/*.spec.ts",
			"**/.norbital/**"
		],
		"skipLocal": true,
		"minTokens": 80,
		"ignoreImports": true
	},
	"ignoreDependencies": ["svelte-sonner", "@internationalized/date"],
	"health": {
		"maxCyclomatic": 40,
		"maxCognitive": 50,
		"maxCrap": 900,
		"thresholdOverrides": [
			{
				"files": ["packages/ui/src/collection-table/internal/collection-grid.svelte"],
				"functions": ["<template>"],
				"maxCyclomatic": 140,
				"maxCognitive": 330,
				"maxCrap": 17557,
				"reason": "Tracked debt, pinned at its current numbers so it cannot drift upward. The grid template is one stateful surface at cyclomatic 132 / cognitive 320 and 1111 lines, roughly 3x the project bar, and is the only complexity finding left in this repo. CRAP is 17556 because the template has no direct coverage; the number falls on its own once the grid is exercised or split. Recorded rather than exempted: splitting it is its own piece of work."
			}
		]
	}
}
