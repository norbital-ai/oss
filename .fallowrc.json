		"packages/platform-utils/src/system/types.ts",
		"packages/platform-utils/src/system/workspace-schema.ts",
		"packages/platform-utils/src/tenant_db/bootstrap.ts",
		"packages/platform-utils/src/tenant_db/neon-branch-utils.ts",
		"packages/platform-utils/src/tenant_db/neon-provider.ts",
		"packages/platform-utils/src/tenant_db/provider.ts",
		"packages/platform-utils/src/tenant_db/schema.ts",
		"packages/platform-utils/src/tenant_workspace/build-output.ts",
		"packages/platform-utils/src/tenant_workspace/index.ts",
		"packages/platform-utils/src/tenant_workspace/migrations/applier.ts",
		"packages/platform-utils/src/tenant_workspace/migrations/errors.ts",
		"packages/platform-utils/src/tenant_workspace/migrations/generate.ts",
		"packages/platform-utils/src/tenant_workspace/migrations/migrations.ts",
		"packages/platform-utils/src/tenant_workspace/source.ts",
		"packages/pod/scripts/*.ts",
		"packages/pod/src/authoring/index.ts",
		"packages/pod/src/authoring/internals.ts",
		"packages/pod/src/bin/invocation/index.ts",
		"packages/pod/src/bin/invocation/standalone.ts",
		"packages/pod/src/host/config.ts",
		"packages/pod/src/host/index.ts",
		"packages/pod/src/host/jobs.ts",
		"packages/pod/src/host/webhook-inbound.ts",
		"packages/pod/src/ui/public.ts",
		"packages/pod/src/ui/state/client.ts",
		"packages/pod/src/ui/shell/mount-client.ts",
		"packages/pod/src/serve/hosted.ts",
		"packages/pod/src/server/entry.ts",
		"packages/pod/src/vite/index.ts",
		"packages/std/src/async/index.ts",
		"packages/std/src/billing/index.ts",
		"packages/std/src/cache/index.ts",
		"packages/std/src/cel/index.ts",
		"packages/std/src/date/index.ts",
		"packages/std/src/error/index.ts",
		"packages/std/src/finance/index.ts",
		"packages/std/src/index.ts",
		"packages/std/src/json/index.ts",
		"packages/std/src/reckon/index.ts",
		"packages/std/src/result/index.ts",
		"packages/std/src/schema/index.ts",
		"packages/std/src/string/index.ts",
		"packages/std/src/text/dedent/index.ts",
		"packages/std/src/text/index.ts",
		"packages/std/src/tree/index.ts",
		"packages/std/src/truncate/index.ts",
		"packages/ui/src/**/*.svelte",
		"packages/ui/src/**/*.ts",
		"packages/ui/src/**/*/index.svelte",
		"packages/ui/src/**/*/index.ts",
		"packages/ui/src/code-editor/theme.ts",
		"packages/ui/src/collection-table/collection-table-navigation.svelte.ts",
		"packages/ui/src/feature-colors/index.ts",
		"packages/ui/src/utils/**/*.svelte",
		"packages/ui/src/utils/**/*.ts",
		"packages/ui/src/utils/pixel-drag.ts",
		"scripts/*.mjs",
		"template_workspaces/*/scripts/*.mjs",
		"template_workspaces/*/src/**/*.svelte",
		"template_workspaces/*/src/**/+*.ts",
		"template_workspaces/*/vite.config.ts"
	],
	"rules": {
		"unused-exports": "off",
		"unused-types": "off",
		"unused-class-members": "off",
		"duplicate-exports": "off",
		"circular-dependencies": "off",
		"unused-files": "error",
		"unused-dependencies": "error",
		"unlisted-dependencies": "error"
	},
	"ignorePatterns": [
		"**/.svelte-kit/**",
		"**/build/**",
		"**/.norbital/**",
		"**/coverage/**",
		"**/test-results/**",
		"**/playwright-report/**",
		"**/*.test-d.ts",
		"**/.generated/**",
		"release/**"
	],
	"duplicates": {
		"ignore": [
			"**/node_modules/**",
			"**/build/**",
			"**/.svelte-kit/**",
			"**/*.test.ts",
			"**/*.spec.ts",
			"**/.norbital/**",
			"template_workspaces/**"
		],
		"skipLocal": true,
		"minTokens": 80,
		"ignoreImports": true
	},
	"ignoreDependencies": ["svelte-sonner", "@internationalized/date"],
	"health": {
		"maxCyclomatic": 40,
		"maxCognitive": 50,
		"maxCrap": 900,
		"thresholdOverrides": [
			{
				"files": ["packages/ui/src/collection-table/internal/collection-grid.svelte"],
				"functions": ["<template>"],
				"maxCyclomatic": 140,
				"maxCognitive": 330,
				"maxCrap": 17557,
				"reason": "Tracked debt, pinned at its current numbers so it cannot drift upward. The grid template is one stateful surface at cyclomatic 132 / cognitive 320 and 1111 lines, roughly 3x the project bar, and is the only complexity finding left in this repo. CRAP is 17556 because the template has no direct coverage; the number falls on its own once the grid is exercised or split. Recorded rather than exempted: splitting it is its own piece of work."
			}
		]
	}
}
