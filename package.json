{
	"name": "@norbital-ai/oss",
	"private": true,
	"packageManager": "pnpm@11.15.1",
	"engines": {
		"node": ">=26.0.0"
	},
	"scripts": {
		"build": "turbo build",
		"lint": "turbo lint",
		"test": "turbo test",
		"packages:build": "pnpm --filter @norbital-ai/pod... build",
		"check": "pnpm packages:build && pnpm templates:sync && pnpm lint && pnpm test && pnpm build && pnpm templates:check && pnpm publication:check",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "pnpm check && changeset publish",
		"publication:check": "node scripts/validate-package-publication.mjs",
		"templates:sync": "node scripts/sync-templates.mjs",
		"templates:check": "node scripts/project-templates.mjs --check",
		"templates:project": "node scripts/project-templates.mjs --update-local --output .tmp/template-revisions.json",
		"release:manifest": "node scripts/generate-platform-release.mjs"
	},
	"devDependencies": {
		"@changesets/cli": "2.31.1",
		"@types/node": "^26.1.1",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"prettier": "^3.9.5",
		"prettier-plugin-svelte": "^4.1.1",
		"turbo": "^2.10.5"
	}
}
