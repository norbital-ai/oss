{
	"name": "@template/hr-payroll",
	"description": "Multi-country, shift-aware HR and payroll workspace",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"sync": "pod sync",
		"sync:watch": "pod sync --watch",
		"build": "vite build && node scripts/verify-built-xlsx.mjs",
		"format": "prettier --write .",
		"lint": "prettier --check . && svelte-check --tsconfig ./tsconfig.json",
		"test": "node scripts/verify-overtime-controls.mjs && node --experimental-strip-types --test src/collections/repayment_agreements/*.test.ts"
	},
	"dependencies": {
		"@iconify/svelte": "^5.2.2",
		"@norbital-ai/platform-utils": "0.0.1",
		"@norbital-ai/pod": "0.0.1",
		"@norbital-ai/std": "0.0.1",
		"@norbital-ai/ui": "0.0.1",
		"exceljs": "4.4.0",
		"mode-watcher": "^1.1.0",
		"runed": "^0.37.1",
		"svelte": "^5.56.7",
		"svelte-sonner": "^1.1.1",
		"vite": "^8.1.5",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"prettier": "^3.9.5",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte-check": "^4.7.3",
		"typescript": "6.0.3"
	}
}
