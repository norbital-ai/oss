{
	"name": "@norbital-ai/oss",
	"version": "0.0.7",
	"private": true,
	"packageManager": "pnpm@11.22.0",
	"engines": {
		"node": ">=26.0.0"
	},
	"scripts": {
		"build": "turbo build --concurrency=1",
		"check": "pnpm packages:build && pnpm lint && pnpm test && pnpm test:scripts && pnpm build && pnpm publication:check",
		"check:ci": "pnpm packages:build && pnpm lint && pnpm test && pnpm test:scripts && pnpm build && pnpm publication:check",
		"check:packages:ci": "pnpm exec turbo run build --concurrency=1 && pnpm exec turbo run lint --concurrency=1 && pnpm test && pnpm test:scripts && pnpm publication:check",
		"dr": "node packages/doctor/build/cli.js audit --root .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "turbo lint",
		"packages:build": "pnpm --filter @norbital-ai/ui... build",
		"packages:resolve": "node scripts/resolve-published-packages.mjs",
		"publication:check": "node scripts/validate-package-publication.mjs",
		"skills:check": "node scripts/generate-skills.mjs --check",
		"skills:generate": "node scripts/generate-skills.mjs",
		"test": "turbo test",
		"test:integration": "turbo test:integration",
		"test:scripts": "node --test scripts/tests/*.test.mjs",
		"yalc:publish": "node scripts/yalc-publish.mjs",
		"yalc:refresh": "node scripts/yalc-refresh.mjs"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"effect": "4.0.0-rc.111",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"turbo": "^2.10.11",
		"yalc": "1.0.0-pre.53",
		"yaml": "^2.9.0"
	}
}
