{
	"name": "@norbital-ai/oss",
	"version": "0.0.5",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.22.0",
	"engines": {
		"node": ">=26.0.0"
	},
	"scripts": {
		"build": "turbo build --concurrency=1",
		"check": "pnpm packages:build && pnpm lint && pnpm types:compat && pnpm test && pnpm build && pnpm publication:check",
		"check:packages:ci": "pnpm exec turbo run build --concurrency=1 && pnpm exec turbo run lint --concurrency=1 && pnpm types:compat && pnpm test && pnpm publication:check",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "turbo lint && node packages/bolt/src/test/lint.ts packages scripts",
		"packages:build": "pnpm --filter @norbital-ai/ui... build",
		"packages:resolve": "node scripts/resolve-published-packages.ts",
		"publication:check": "node scripts/validate-package-publication.ts",
		"test": "NODE_OPTIONS=\"--no-node-snapshot --no-experimental-webstorage\" vitest run",
		"types:compat": "turbo run types:compat --filter=@norbital-ai/bolt"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:",
		"@effect/vitest": "catalog:",
		"@types/node": "^26.6.5",
		"@typescript/native": "npm:typescript@7.0.2",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"@vitest/browser-playwright": "5.0.5",
		"effect": "catalog:",
		"happy-dom": "21.0.4",
		"playwright": "1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"turbo": "^2.11.10",
		"typescript": "catalog:",
		"vitest": "5.0.5",
		"yaml": "^2.9.1"
	}
}
